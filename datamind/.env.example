# ==============================================================================
# DATAMIND (PS1) - Snowflake & Gemma Configuration
# ==============================================================================

# 1. Snowflake Credentials
# ------------------------
# Account Identifier: Find this in Snowflake web UI at bottom-left corner -> Account -> Copy Account Identifier.
# Format example: xy12345.ap-south-1.aws or abcdefg-hi12345
SNOWFLAKE_ACCOUNT=ol15456
SNOWFLAKE_HOST=ol15456.ap-south-1.aws.snowflakecomputing.com

# Your login username and password
SNOWFLAKE_USER=YOUR_USERNAME
SNOWFLAKE_PASSWORD=YOUR_PASSWORD

# Snowflake Warehouse, Database, Schema, and Role
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=DATAMIND_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ACCOUNTADMIN

# 2. Gemma Model Inference (OpenRouter API)
# ----------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMMA_MODEL=google/gemma-4-26b-a4b-it

# Optional Secondary Key (NVIDIA NIM)
NVIDIA_API_KEY=your_nvidia_api_key_here
